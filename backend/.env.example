# Explicit local application database, separate from all *_test databases.
ENV=development
DATABASE_URL=postgresql+asyncpg://test:test@localhost:55438/bookmarks_local_dev
REDIS_URL=redis://localhost:56388/0

# External APIs
YOUTUBE_API_KEY=

GEMINI_API_KEY=

GROQ_API_KEY=


# Existing Clerk instance. Missing values reject protected requests.
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Set only if the existing session configuration includes an audience.
CLERK_AUDIENCE=
# Required before enabling real WebSub subscriptions; receive only signed deliveries.
PUBSUB_SIGNING_SECRET=
